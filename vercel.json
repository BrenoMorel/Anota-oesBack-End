{
  "version": 2,
  "builds": [
    {
      "src": "JogoSocket/queimada-online/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "JogoSocket/queimada-online/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/socket.io/(.*)",
      "dest": "JogoSocket/queimada-online/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "JogoSocket/queimada-online/public/"
    }
  ]
}
